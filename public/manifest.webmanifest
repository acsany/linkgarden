{
  "id": "/admin",
  "name": "Linkgarden",
  "short_name": "Linkgarden",
  "description": "Manage your short URLs, link pages, and analytics.",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f7f8fa",
  "theme_color": "#6855d9",
  "lang": "en",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Pages", "url": "/admin" },
    { "name": "New page", "url": "/admin/sites/new" }
  ]
}
