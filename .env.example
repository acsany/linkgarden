# Local development is loopback-only. Without DATABASE_URL, embedded PostgreSQL
# (PGlite) persists in .data/. Never point a local agent at an untrusted network.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# DATABASE_URL=postgresql://linkgarden:password@localhost:5432/linkgarden
# PG_SSL=false
# Uploaded PDFs default to .data-files/ locally; production requires FILES_DIR.
# FILES_DIR=/var/data/files
# MAX_UPLOAD_MB=25
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD_HASH=... (run npm run admin:setup; never store plaintext passwords)
# MCP is disabled until a token is created in Admin > Agent access.
